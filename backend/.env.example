# Prisma komutları için: bu dosyayı .env olarak kopyalayın veya kök .env kullanın.
DATABASE_URL="postgresql://prepup:prepup@localhost:5432/prepup?schema=public"

# Google AI Studio veya GCP üzerinden API anahtarı (CV PDF analizi)
GEMINI_API_KEY=""
# Örn: gemini-2.0-flash | gemini-1.5-flash (gemini-1.5-pro çoğu AI Studio anahtarında 404 verir)
GEMINI_MODEL="gemini-2.0-flash"
